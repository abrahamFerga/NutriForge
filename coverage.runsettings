<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>
            [NutriForge.*.Tests]*
            [NutriForge.IntegrationTests]*
            [NutriForge.E2E]*
            [*]*.Migrations.*
          </Exclude>
          <ExcludeByAttribute>
            GeneratedCode
            CompilerGeneratedAttribute
            ExcludeFromCodeCoverage
          </ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
