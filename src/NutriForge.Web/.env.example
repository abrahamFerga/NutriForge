VITE_API_BASE=http://localhost:5000

# Real auth (Entra External ID / OIDC). Leave UNSET for local dev (the app uses the dev-auth headers
# the API trusts only in Development). Set all three to switch the SPA to Auth-Code + PKCE login:
# VITE_AUTH_AUTHORITY=https://<your-tenant>.ciamlogin.com/<tenant-id>/
# VITE_AUTH_CLIENT_ID=<spa-app-client-id>
# VITE_AUTH_SCOPE=api://<api-app-client-id>/access_as_user
